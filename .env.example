# Salin ke .env lalu sesuaikan. Semua opsional (lihat app/config.py untuk default).
APP_ACCESS_TOKEN=ganti-dengan-token-acak
APP_WHISPER_MODEL=small
APP_WHISPER_DEVICE=cuda
APP_WHISPER_COMPUTE_TYPE=int8_float16
APP_LLM_BACKEND=ollama
APP_OLLAMA_MODEL=qwen2.5:3b
APP_GPU_SWAP_POLICY=swap
APP_KEEP_RAW_AUDIO=false
APP_USE_ECAPA=false
# Uji coba LLM cloud (data keluar dari mesin, hanya data fiktif). Dipakai start_local_deepseek.bat:
# APP_DEEPSEEK_API_KEY=sk-...
# APP_LLM_BACKEND=llamacpp
# APP_LLAMACPP_MODEL_PATH=C:/models/qwen2.5-3b-instruct-q4_k_m.gguf
