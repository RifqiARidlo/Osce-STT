{
  "version": 1,
  "notes": "Urutan penting: pola lebih spesifik di atas. replacement boleh memakai \\1 (grup tangkap). keep_original=true -> teks asli ditampilkan dalam kurung. Mapping ke GEJALA, bukan diagnosis.",
  "entries": [
    {"pattern": "\\b(?:panas|demam)\\s+(?:sudah\\s+|sejak\\s+)?(\\d+|satu|dua|tiga|empat|lima|enam|tujuh)\\s+hari(?:\\s+(?:ini|yang lalu|lalu))?\\b", "replacement": "febris onset \\1 hari SMRS", "category": "onset"},
    {"pattern": "\\b(?:batuk|watuk)\\s+(?:sudah\\s+|sejak\\s+)?(\\d+|satu|dua|tiga|empat)\\s+minggu\\b", "replacement": "batuk onset \\1 minggu", "category": "onset"},
    {"pattern": "\\bbatuk\\s+(?:ber)?darah\\b", "replacement": "hemoptisis", "category": "gejala"},
    {"pattern": "\\bbatuk\\s+(?:ber)?dahak\\b", "replacement": "batuk produktif", "category": "gejala"},
    {"pattern": "\\bbatuk\\s+kering\\b", "replacement": "batuk non-produktif", "category": "gejala"},
    {"pattern": "\\bsesak(?:\\s+napas|\\s+nafas)?\\b", "replacement": "dispnea", "category": "gejala"},
    {"pattern": "\\b(?:ngik[- ]?ngik|mengi)\\b", "replacement": "wheezing", "category": "gejala"},
    {"pattern": "\\bkeringat\\s+(?:malam|di malam hari)\\b", "replacement": "night sweats", "category": "gejala"},
    {"pattern": "\\bkeringat\\s+dingin\\b", "replacement": "diaforesis", "category": "gejala"},
    {"pattern": "\\bberat\\s+badan\\s+(?:turun|menurun|berkurang)\\b", "replacement": "penurunan berat badan", "category": "gejala"},
    {"pattern": "\\b(?:dada\\s+)?(?:ampeg|ampek|sesek)\\b", "replacement": "rasa berat/sesak di dada", "category": "gejala_lokal"},
    {"pattern": "\\b(?:deg[- ]?degan|berdebar[- ]?debar|jantung\\s+berdebar)\\b", "replacement": "palpitasi", "category": "gejala"},
    {"pattern": "\\bnyeri\\s+ulu\\s+hati\\b|\\bulu\\s+hati\\s+(?:perih|sakit|nyeri)\\b", "replacement": "nyeri epigastrium", "category": "gejala"},
    {"pattern": "\\b(?:mencret|diare|murus)\\b", "replacement": "diare", "category": "gejala_lokal"},
    {"pattern": "\\bmules\\b|\\bmulas\\b", "replacement": "nyeri perut kram (kolik)", "category": "gejala_lokal"},
    {"pattern": "\\bmual\\b", "replacement": "nausea", "category": "gejala"},
    {"pattern": "\\b(?:muntah|mutah|muntah-muntah)\\b", "replacement": "vomitus", "category": "gejala"},
    {"pattern": "\\bkembung\\b", "replacement": "distensi abdomen/kembung", "category": "gejala"},
    {"pattern": "\\bsusah\\s+(?:bab|buang air besar)\\b", "replacement": "konstipasi", "category": "gejala"},
    {"pattern": "\\b(?:nggliyeng|ngliyeng|gliyeng|nggleyeng)\\b", "replacement": "pusing berputar", "category": "gejala_lokal"},
    {"pattern": "\\b(?:mumet|ngelu|nyut[- ]?nyutan)\\b", "replacement": "sefalgia", "category": "gejala_lokal"},
    {"pattern": "\\bsakit\\s+kepala\\b|\\bkepala\\s+(?:sakit|pusing)\\b", "replacement": "sefalgia", "category": "gejala"},
    {"pattern": "\\b(?:kemeng|pegel[- ]?pegel|pegal[- ]?pegal|pegel)\\b", "replacement": "mialgia", "category": "gejala_lokal"},
    {"pattern": "\\b(?:linu|ngilu\\s+sendi|sendi\\s+(?:sakit|nyeri|ngilu))\\b", "replacement": "artralgia", "category": "gejala_lokal"},
    {"pattern": "\\b(?:meriang|nggreges|sumeng|anget[- ]?anget)\\b", "replacement": "subfebris/malaise", "category": "gejala_lokal"},
    {"pattern": "\\bmasuk\\s+angin\\b", "replacement": "malaise, kembung", "category": "gejala_lokal"},
    {"pattern": "\\b(?:lemes|lemas|loyo)\\b", "replacement": "malaise", "category": "gejala_lokal"},
    {"pattern": "\\bpilek\\b|\\bingus(?:an)?\\b", "replacement": "rinore", "category": "gejala"},
    {"pattern": "\\b(?:anyang[- ]?anyangen|beser)\\b", "replacement": "polakisuria/disuria", "category": "gejala_lokal"},
    {"pattern": "\\b(?:kencing|pipis)\\s+(?:sakit|perih|panas)\\b", "replacement": "disuria", "category": "gejala"},
    {"pattern": "\\bsusah\\s+tidur\\b", "replacement": "insomnia", "category": "gejala"},
    {"pattern": "\\bgatal(?:[- ]gatal)?\\b", "replacement": "pruritus", "category": "gejala"},
    {"pattern": "\\b(?:bengkak|abuh)\\b", "replacement": "edema", "category": "gejala_lokal"},
    {"pattern": "\\bkencing\\s+manis\\b|\\bgula\\s+darah\\s+tinggi\\b", "replacement": "riwayat diabetes melitus", "category": "riwayat"},
    {"pattern": "\\bdarah\\s+tinggi\\b", "replacement": "riwayat hipertensi", "category": "riwayat"},
    {"pattern": "\\btensi(?:nya)?\\b", "replacement": "tekanan darah", "keep_original": false, "category": "pemeriksaan"},
    {"pattern": "\\b(\\d{2,3})\\s*(?:per|/)\\s*(\\d{2,3})\\b", "replacement": "\\1/\\2 mmHg", "keep_original": false, "category": "pemeriksaan"}
  ]
}
